  back.tick();
if(down.press()){oled.roundRect(2, 2, 32, 32, OLED_CLEAR);  oled.drawBitmap(4, 4, bitmap_26x26_plus, 26, 26); oled.roundRect(2, 32, 32, 62, OLED_STROKE); oled.update();sign = 1;lock = 1;}
if(up.press()){oled.roundRect(2, 32, 32, 62, OLED_CLEAR); oled.drawBitmap(4, 34, bitmap_26x26_min, 26, 26); oled.roundRect(2, 2, 32, 32,OLED_STROKE); oled.update();sign = 0;lock = 1;}
if(ok.press()&&speaker_loud>=0&&speaker_loud<=5&&lock == 1){if(sign == 0&&speaker_loud<5){speaker_loud=speaker_loud+1;}if(sign == 1&&speaker_loud>0){speaker_loud=speaker_loud-1;} 
oled.setCursorXY(71, 40); // курсор в (пиксель X, пиксель Y)
