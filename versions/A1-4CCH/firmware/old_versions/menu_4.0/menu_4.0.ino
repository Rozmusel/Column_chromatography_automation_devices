    oled.rect(60,40,70,60, OLED_FILL);
    oled.rect(75,30,85,60, OLED_FILL);
    oled.rect(90,20,100,60, OLED_FILL);
    oled.rect(105,10,115,60, OLED_FILL);
    break;
  }
  oled.update();
  lock = 0;
 for (;;) {
  up.tick();                 // Опрос кнопок
  down.tick();
